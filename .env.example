# LLM —— DeepSeek Anthropic 兼容接口
LLM_API_STYLE=anthropic
LLM_BASE_URL=https://api.deepseek.com/anthropic
# LLM_API_KEY 由环境变量 ANTHROPIC_AUTH_TOKEN 提供，此处不落盘明文密钥
LLM_API_KEY=__from_env__
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=8000

# 多轮辅助任务（查询改写 / 滚动摘要）
# off = 传 thinking={"type":"disabled"}，避免 thinking 吃满 JSON/摘要预算
LLM_AUX_THINKING=off
# REWRITE_MAX_TOKENS=2000
# REWRITE_MIN_CONFIDENCE=0.5
# SUMMARY_MAX_TOKENS=1200

# 查询改写：本地 Ollama 小模型（LLM_REWRITE_PROVIDER=main 可回退主模型）
LLM_REWRITE_PROVIDER=ollama
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_CHAT_MODEL=qwen3:4B-Instruct
OLLAMA_CHAT_TIMEOUT=120

# Embedding —— Ollama 本地
OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
OLLAMA_EMBED_MODEL=nomic-embed-text

# 知识库路径：默认取本目录下 vault/ 与 index/（见 common.py），
# 需要自定义时取消注释并填写绝对路径。
# RAG_VAULT_PATH=/absolute/path/to/vault
# RAG_INDEX_PATH=/absolute/path/to/index

# 服务端口（三端口一致，仅端口不同）
# RAG_PORT 由启动脚本显式注入；直接运行 server.py 时代码默认 8000
RAG_AUTO_PORT=8001
RAG_V3_PORT=8002

# Embedding 单条字符上限（防止超出模型上下文，默认 1500）
# OLLAMA_EMBED_MAX_CHARS=1500
