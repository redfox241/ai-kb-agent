    {
      "id": "mh-05",
      "type": "multi_hop",
      "question": "从长征到百团大战，红军的作战对象和作战方式发生了什么变化？",
      "gold_docs": ["wiki/concepts/长征.md", "wiki/concepts/百团大战.md"],
